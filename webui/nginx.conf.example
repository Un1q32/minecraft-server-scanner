# Example nginx site for the local web UI.
#
# Run the app on loopback only:
#   python webui/webui.py --host 127.0.0.1 --port 8080 --no-browser
#
# Replace db.example.com and the certificate paths.
# Install with:
#   sudo cp webui/nginx.conf.example /etc/nginx/sites-available/mc-webui
#   sudo ln -s /etc/nginx/sites-available/mc-webui /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx

# Optional rate limit; remove if you do not want it.
limit_req_zone $binary_remote_addr zone=mcweb:10m rate=20r/s;

server {
    listen 80;
    server_name db.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name db.example.com;

    ssl_certificate     /etc/letsencrypt/live/db.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/db.example.com/privkey.pem;

    # No application auth is implemented. Keep the Python server on
    # 127.0.0.1; add nginx auth here if the hostname is not LAN-only.

    # Simplest setup: let the Python server send both the page and the
    # snapshot. Nginx provides TLS and timeouts.
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Stream the ~30 MB database snapshot instead of buffering it first.
        proxy_buffering off;

        limit_req zone=mcweb burst=40 nodelay;
    }
}

