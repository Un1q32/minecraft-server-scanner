# Example nginx site for the local web UI.
#
# Run the app on loopback only:
#   python webui/webui.py --host 127.0.0.1 --port 8080 --no-browser
#
# Replace db.example.com, the certificate paths and the htpasswd path.
# Install with:
#   sudo cp webui/nginx.conf.example /etc/nginx/sites-available/mc-webui
#   sudo ln -s /etc/nginx/sites-available/mc-webui /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx

# Optional rate limit; remove if you do not want it.
limit_req_zone $binary_remote_addr zone=mcweb:10m rate=20r/s;

server {
    listen 80;
    server_name db.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name db.example.com;

    ssl_certificate     /etc/letsencrypt/live/db.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/db.example.com/privkey.pem;

    # The database is effectively private scanner data, and Sync DB can
    # start a process. Keep this behind auth unless it is LAN-only.
    auth_basic           "MC server DB";
    auth_basic_user_file /etc/nginx/.htpasswd;

    client_max_body_size 1m;

    # Simplest setup: let the Python server send both the page and the
    # snapshot. Nginx provides TLS, auth and timeouts.
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Sync DB can run for up to ten minutes.
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;

        # Stream the ~30 MB database snapshot instead of buffering it first.
        proxy_buffering off;

        limit_req zone=mcweb burst=40 nodelay;
    }
}

