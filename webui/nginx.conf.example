# Static nginx site for the web DB viewer.
#
# There is no Python process. Nginx serves:
#   - webui/static/index.html, app.js, style.css, core.js, core.wasm
#   - the live servers.db and servers.db-wal directly from disk
#   - an optional precompressed servers.db.zst snapshot
#
# Notes are not part of the web viewer and are not served here.
#
# Adjust the static root and the two aliases below, then install:
#   sudo cp webui/nginx.conf.example /etc/nginx/sites-available/mc-webui
#   sudo ln -s /etc/nginx/sites-available/mc-webui /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# The nginx worker user must be able to read the static directory and both
# database files, and traverse every parent directory.

server {
    listen 80;
    server_name db.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name db.example.com;

    ssl_certificate     /etc/letsencrypt/live/db.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/db.example.com/privkey.pem;

    # No application authentication: this serves the public servers DB only.
    # Add Basic auth or allow/deny here if the hostname is not LAN-only.

    root /home/uniq/devel/minecraft-server-scanner/webui/static;
    index index.html;

    # Keep these explicit so a minimal nginx without mime.types still serves
    # the WASM module and scripts correctly.
    types {
        text/html html htm;
        text/css css;
        text/javascript js;
        application/wasm wasm;
        application/json json;
        application/octet-stream db;
        application/zstd zst;
    }

    add_header X-Content-Type-Options nosniff always;

    # The live SQLite database. Point the alias at the real path (or a
    # symlink to netdb.sqlite3). Cache-Control prevents the browser reusing
    # an old copy after a scan.
    location = /servers.db {
        alias /home/uniq/devel/minecraft-server-scanner/servers.db;
        default_type application/octet-stream;
        gzip off;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
    }

    # Precompressed consistent snapshot (see webui/compress_db.py). The
    # viewer decompresses it with fzstd.js. Do not set Content-Encoding:
    # the browser fetches the compressed bytes and unpacks them itself.
    location = /servers.db.zst {
        alias /home/uniq/devel/minecraft-server-scanner/servers.db.zst;
        default_type application/octet-stream;
        gzip off;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
    }

    # SQLite's WAL sidecar. A 404 is normal when the WAL has been
    # checkpointed or the database is idle; the viewer handles it.
    location = /servers.db-wal {
        alias /home/uniq/devel/minecraft-server-scanner/servers.db-wal;
        default_type application/octet-stream;
        gzip off;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
